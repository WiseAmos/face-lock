# Build artifacts (regenerated by `napi build --release --strip`)
target/
Cargo.lock

# The .node binaries are rebuilt per-platform by CI; we keep the source
# + scripts + the .d.ts/.js loader, but not the platform-specific binaries.
# napi-rs naming convention is `index.<platform>-<arch>[-<abi>].node`.
index.*.node
face-lock-camera.*.node
