# Optional override location for the config file. By default face-lock stores
# config.json inside its own data/ directory (~/.face-lock on the user's system
# after npm install -g). Set FACE_LOCK_CONFIG to point to a custom path.
FACE_LOCK_CONFIG=

# Optional: print verbose detector output to stderr for debugging.
# 0 = silent (default), 1 = FPS + state changes, 2 = full per-frame logging
FACE_LOCK_DEBUG=0

# Optional: force the camera device index. -1 = auto (default).
# On macOS, 0 is usually the built-in FaceTime camera. On Linux, try 0 or 1.
FACE_LOCK_CAMERA_INDEX=-1
